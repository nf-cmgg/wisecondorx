{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-cmgg/wisecondorx/main/assets/schema_input.json",
    "title": "nf-cmgg/wisecondorx pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "minLength": 1
            },
            "cram": {
                "type": "string",
                "pattern": "^\\S+\\.(b|cr)am$",
                "format": "file-path",
                "exists": true
            },
            "crai": {
                "type": "string",
                "pattern": "^\\S+\\.(b|cr)ai$",
                "format": "file-path",
                "exists": true
            },
            "npz": {
                "type": "string",
                "pattern": "^\\S+\\.npz$",
                "format": "file-path",
                "exists": true
            },
            "sex": {
                "type": "string",
                "errorMessage": "The sex needs to be either 'male' or 'female'",
                "enum": ["male", "female"]
            }
        },
        "required": ["sample"],
        "oneOf": [
            {
                "required": ["cram"]
            },
            {
                "required": ["npz", "sex"]
            }
        ]
    }
}

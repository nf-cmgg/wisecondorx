nextflow_process {

    name "Test Process SAMTOOLS_FAIDX"
    script "../main.nf"
    process "SAMTOOLS_FAIDX"

    tag "modules"
    tag "modules_nfcore"
    tag "samtools"
    tag "samtools/faidx"
    config "./nextflow.config"

    topics "versions"

    test("test_samtools_faidx") {

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = channel.of(
                    record(
                        id: 'test',
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        get_sizes: false
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out, topics).match()}
            )
        }
    }

    test("test_samtools_faidx_bgzip") {

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = channel.of(
                    record(
                        id: 'test',
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true),
                        get_sizes: false
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out, topics).match()}
            )
        }
    }

    test("test_samtools_faidx_fasta") {

        when {
            params {
                module_args = 'MT192765.1 -o extract.fa'
            }
            process {
                """
                input[0] = channel.of(
                    record(
                        id: 'test',
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        fai: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true),
                        get_sizes: false
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out, topics).match()}
            )
        }
    }

    test("test_samtools_faidx_stub_fasta") {

        options "-stub"
        when {
            params {
                module_args = '-o extract.fa'
            }
            process {
                """
                input[0] = channel.of(
                    record(
                        id: 'test',
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        fai: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true),
                        get_sizes: false
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out, topics).match()}
            )
        }
    }


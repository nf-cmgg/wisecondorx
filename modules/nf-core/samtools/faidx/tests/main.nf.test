    test("test_samtools_faidx_get_sizes_bgzip") {

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = channel.of(
                    record(
                        id: 'test',
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz', checkIfExists: true),

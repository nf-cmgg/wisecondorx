nextflow_process {

    name "Test Process MULTIQC"
    script "../main.nf"
    process "MULTIQC"

    tag "modules"
    tag "modules_nfcore"
    tag "multiqc"

    config "./nextflow.config"

    topics 'versions_multiqc'

    test("sarscov2 single-end [fastqc]") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    multiqc_files: [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true)].toSet(),
                ))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out["0"].collect { rec ->
                    rec.data = path(rec.data).list().collect { file(it.toString()).name }
                    rec.plots = [
                        "pdf",
                        path("${rec.plots}/pdf").list().collect { file(it.toString()).name },
                        "png",
                        path("${rec.plots}/png").list().collect { file(it.toString()).name },
                        "svg",
                        path("${rec.plots}/svg").list().collect { file(it.toString()).name }
                    ]
                    rec.report = file(rec.report.toString()).name
                    return rec
                },
                topics
            ).match()
        }
    }

    test("sarscov2 single-end [fastqc] - custom prefix") {
        config "./custom_prefix.config"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    multiqc_files: [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true)].toSet(),
                ))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out["0"].collect { rec ->
                    rec.data = path(rec.data).list().collect { file(it.toString()).name }
                    rec.plots = [
                        "pdf",
                        path("${rec.plots}/pdf").list().collect { file(it.toString()).name },
                        "png",
                        path("${rec.plots}/png").list().collect { file(it.toString()).name },
                        "svg",
                        path("${rec.plots}/svg").list().collect { file(it.toString()).name }
                    ]
                    rec.report = file(rec.report.toString()).name
                    return rec
                },
                topics
            ).match()
        }
    }

    test("sarscov2 single-end [fastqc] [config]") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    multiqc_files: [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true)].toSet(),
                    multiqc_config: [file("https://raw.githubusercontent.com/nf-core/seqinspector/1.0.0/assets/multiqc_config.yml", checkIfExists: true)].toSet()
                ))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out["0"].collect { rec ->
                    rec.data = path(rec.data).list().collect { file(it.toString()).name }
                    rec.plots = [
                        "pdf",
                        path("${rec.plots}/pdf").list().collect { file(it.toString()).name },
                        "png",
                        path("${rec.plots}/png").list().collect { file(it.toString()).name },
                        "svg",
                        path("${rec.plots}/svg").list().collect { file(it.toString()).name }
                    ]
                    rec.report = file(rec.report.toString()).name
                    return rec
                },
                topics
            ).match()
        }
    }

    test("sarscov2 single-end [fastqc] [multiple configs]") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    multiqc_files: [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true)].toSet(),
                    multiqc_config: [
                        file("https://raw.githubusercontent.com/nf-core/seqinspector/1.0.0/assets/multiqc_config.yml", checkIfExists: true),
                        file("https://raw.githubusercontent.com/nf-core/seqinspector/1.0.0/assets/multiqc_config.yml", checkIfExists: true)
                    ].toSet()
                ))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out["0"].collect { rec ->
                    rec.data = path(rec.data).list().collect { file(it.toString()).name }
                    rec.plots = [
                        "pdf",
                        path("${rec.plots}/pdf").list().collect { file(it.toString()).name },
                        "png",
                        path("${rec.plots}/png").list().collect { file(it.toString()).name },
                        "svg",
                        path("${rec.plots}/svg").list().collect { file(it.toString()).name }
                    ]
                    rec.report = file(rec.report.toString()).name
                    return rec
                },
                topics
            ).match()
        }
    }

    test("sarscov2 single-end [fastqc] - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    multiqc_files: [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true)].toSet(),
                    multiqc_config: [file("https://raw.githubusercontent.com/nf-core/seqinspector/1.0.0/assets/multiqc_config.yml", checkIfExists: true)].toSet()
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out, topics).match() }
            )
        }
    }
}

nextflow_pipeline {

    name "Run a full test"
    script "main.nf"
    options "-stub"

    tag "pipeline"

    test("Success") {

        when {
            params {
                input  = "${projectDir}/tests/inputs/samplesheet.csv"
                outdir = "${outputDir}"
                prefix = "test_reference"
                bin_sizes = "10,5"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    getAllFilesFromDir(params.outdir, ignore: ['pipeline_info/*'])
                ).match() }
            )
        }
    }
}

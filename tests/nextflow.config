/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

params {
    fasta = params.pipelines_testdata_base_path + "data/genomics/homo_sapiens/genome/seq/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set_chr21.fna"
    fai   = params.pipelines_testdata_base_path + "data/genomics/homo_sapiens/genome/seq/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set_chr21.fna.fai"

    genomes_ignore  = true
    igenomes_ignore = true

    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
}
